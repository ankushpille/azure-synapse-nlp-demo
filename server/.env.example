# server\.env.example
# Copy this file to .env and fill in your values

# --- Server Configuration ---
PORT=3001
NODE_ENV=development
LOG_LEVEL=debug
ENABLE_CONSOLE_LOGGING=true
ENABLE_APPINSIGHTS=true

# --- Azure Synapse Configuration ---
SYNAPSE_SERVER=your-synapse-server.sql.azuresynapse.net
SYNAPSE_DATABASE=nlp_poc
AZURE_TENANT_ID=your-azure-tenant-id
AZURE_CLIENT_ID=your-azure-client-id
AZURE_CLIENT_SECRET=your-azure-client-secret

# --- Azure Table Storage Configuration ---
AZURE_TABLES_CONNECTION_STRING=your-azure-tables-connection-string
QUERY_LOGS_TABLE_NAME=QueryLogs
FEEDBACK_LOGS_TABLE_NAME=FeedbackLogs

# --- Application Insights Configuration ---
APPINSIGHTS_CONNECTION_STRING=your-application-insights-connection-string
